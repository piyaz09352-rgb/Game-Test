{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firebase/**", "**/.*", "docs/**", "tools/**", "*.md", "tests/**", "node_modules/**", "package.json", "package-lock.json"],
    "headers": [{ "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "max-age=300" }] }]
  },
  "firestore": { "rules": "firebase/firestore.rules" },
  "database": { "rules": "firebase/database.rules.json" }
}
